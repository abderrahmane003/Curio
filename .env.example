# GEMINI_API_KEY: Requis pour la génération de questions par IA côté serveur.
# Injecté automatiquement par AI Studio au runtime depuis les secrets utilisateur.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL de l'application hôte.
APP_URL="MY_APP_URL"

# FIREBASE CLIENT CONFIG (Optionnel si auto-provisionné via AI Studio, nécessaire sur Vercel externe)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="erudit-culture.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="erudit-culture"
VITE_FIREBASE_STORAGE_BUCKET="erudit-culture.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
